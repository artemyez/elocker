<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "eLocker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="eLocker">
    <%= javascript_include_tag "turbo", type: "module", "data-turbo-track": "reload" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:block focus:bg-white focus:p-4 focus:text-indigo-700">Skip to content</a>
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-6xl space-y-5 px-4 py-5 sm:px-6">
        <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
          <%= link_to "eLocker", lockers_path, class: "text-xl font-bold tracking-tight focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-600" %>
          <nav aria-label="Main navigation" class="flex gap-5 text-sm font-medium">
            <%= link_to "Lockers", lockers_path, aria: { current: controller_name == "lockers" ? "page" : nil }, class: "text-slate-600 hover:text-indigo-700 aria-[current=page]:text-indigo-700 aria-[current=page]:underline underline-offset-8 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-600" %>
            <%= link_to "Action log", locker_actions_path, aria: { current: controller_name == "locker_actions" ? "page" : nil }, class: "text-slate-600 hover:text-indigo-700 aria-[current=page]:text-indigo-700 aria-[current=page]:underline underline-offset-8 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-600" %>
          </nav>
        </div>
        <% if current_user %>
          <div class="flex flex-col gap-4 border-t border-slate-100 pt-4 lg:flex-row lg:items-end lg:justify-between">
            <div class="min-w-0">
              <p class="break-words text-sm font-semibold"><%= current_user.name %></p>
              <p class="mt-1 break-words text-sm text-slate-500"><%= user_context(current_user) %></p>
            </div>
            <%= form_with url: current_user_path, method: :patch, local: true, class: "flex w-full min-w-0 flex-col gap-2 sm:flex-row sm:items-end lg:w-auto" do |form| %>
              <div class="min-w-0 flex-1">
                <%= form.label :user_id, "Demo user", class: "mb-1 block text-xs font-semibold text-slate-600" %>
                <%= form.select :user_id, available_users.map { |user| [user_option_label(user), user.id] }, { selected: current_user.id }, class: "w-full min-w-0 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
              </div>
              <%= form.submit "Switch user", class: "shrink-0 cursor-pointer rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </header>
    <main id="main" class="mx-auto max-w-6xl px-4 py-8 sm:px-6" tabindex="-1">
      <% flash.each do |type, message| %>
        <%= tag.div message, role: type == "alert" ? "alert" : "status", class: "mb-6 rounded-lg border px-4 py-3 text-sm #{type == 'alert' ? 'border-red-200 bg-red-50 text-red-800' : 'border-emerald-200 bg-emerald-50 text-emerald-800'}" %>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
