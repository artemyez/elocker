<% content_for :title, "Lockers · eLocker" %>
<div class="mb-6">
  <h1 class="text-2xl font-bold tracking-tight">Lockers</h1>
  <p class="mt-2 text-sm text-slate-500">View and operate the lockers available to you.</p>
</div>
<% if @lockers.empty? %>
  <div class="rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center">
    <h2 class="font-semibold">No lockers available</h2>
    <p class="mt-2 text-sm text-slate-500">Your team has no assigned lockers. Contact eLocker support if you need access.</p>
  </div>
<% else %>
  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white focus-visible:outline-2 focus-visible:outline-indigo-600" role="region" aria-label="Available lockers" tabindex="0">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-slate-200 bg-slate-100 text-xs uppercase tracking-wide text-slate-600">
        <tr>
          <th scope="col" class="px-5 py-3">Locker</th>
          <th scope="col" class="px-5 py-3">Company</th>
          <th scope="col" class="px-5 py-3">Location</th>
          <th scope="col" class="px-5 py-3">State</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @lockers.each do |locker| %>
          <tr>
            <td class="px-5 py-4">
              <%= link_to locker.name, locker_path(locker), class: "font-semibold text-indigo-700 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
              <p class="mt-1 text-xs text-slate-500"><%= locker.identifier %></p>
            </td>
            <td class="px-5 py-4"><%= locker.company.name %></td>
            <td class="px-5 py-4 text-slate-600"><%= locker.location %></td>
            <td class="px-5 py-4"><%= locker_state_badge(locker) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
