<% if actions.empty? %>
  <div class="rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">
    No actions recorded for these lockers yet.
  </div>
<% else %>
  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white focus-visible:outline-2 focus-visible:outline-indigo-600" role="region" aria-label="Action history" tabindex="0">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-slate-200 bg-slate-100 text-xs uppercase tracking-wide text-slate-600">
        <tr>
          <th scope="col" class="px-5 py-3">Time</th>
          <% if show_locker %>
            <th scope="col" class="px-5 py-3">Locker</th>
            <th scope="col" class="px-5 py-3">Company</th>
          <% end %>
          <th scope="col" class="px-5 py-3">Action</th>
          <th scope="col" class="px-5 py-3">Performed by</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% actions.each do |action| %>
          <tr>
            <td class="whitespace-nowrap px-5 py-4 text-slate-600"><%= action_time(action.occurred_at) %></td>
            <% if show_locker %>
              <td class="px-5 py-4">
                <%= link_to action.locker.name, locker_path(action.locker), class: "font-medium text-indigo-700 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
                <p class="mt-1 text-xs text-slate-500"><%= action.locker.identifier %></p>
              </td>
              <td class="px-5 py-4"><%= action.locker.company.name %></td>
            <% end %>
            <td class="px-5 py-4 font-medium"><%= action.action.capitalize %></td>
            <td class="px-5 py-4"><%= action.user.name %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
